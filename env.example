# ============================================
# AUCTION BOT CONFIGURATION
# ============================================

# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# CryptoPay API Token
# Получить: https://t.me/CryptoBot -> Crypto Pay -> Мои приложения -> Создать приложение
CRYPTO_PAY_TOKEN=your_crypto_pay_token_here

# ID администраторов (через запятую)
# Узнать свой ID: @userinfobot
ADMIN_IDS=123456789,987654321

# ============================================
# НАСТРОЙКИ АУКЦИОНОВ (опционально)
# ============================================

# Стартовая ставка по умолчанию (USDT)
DEFAULT_START_BID=10.0

# Минимальный шаг ставки по умолчанию (USDT)
DEFAULT_MIN_STEP=1.0

# Время на перебив по умолчанию (секунды)
DEFAULT_BID_TIME=60

# Комиссия платформы (0.30 = 30%)
PLATFORM_FEE=0.30

# ============================================
# БАЗА ДАННЫХ
# ============================================

# Путь к файлу SQLite
DB_PATH=auction_bot.db
